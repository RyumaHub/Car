<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roles: La Peste Negra - Grado 7°</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1a1a1a;
            color: #e0e0e0;
            text-align: center;
            padding: 20px;
        }
        h1 { color: #cfb53b; text-shadow: 2px 2px #000; }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }
        .card {
            background-color: #2c2c2c;
            border: 2px solid #444;
            border-radius: 10px;
            width: 250px;
            padding: 20px;
            transition: transform 0.3s;
        }
        .card:hover {
            transform: translateY(-10px);
            border-color: #cfb53b;
        }
        .card h3 { color: #cfb53b; margin-bottom: 10px; }
        button {
            background-color: #cfb53b;
            color: black;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover { background-color: #f1d35f; }
        #detalle {
            margin-top: 40px;
            padding: 20px;
            background: #333;
            border-radius: 10px;
            display: none;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            border-left: 5px solid #cfb53b;
        }
        .instruccion { text-align: left; }
        strong { color: #cfb53b; }
    </style>
</head>
<body>

    <h1>Elección de Roles: Grupo de 5</h1>
    <p>Selecciona tu rol para ver tus tareas y lo que debes decir en la exposición:</p>

    <div class="container">
        <div class="card">
            <h3>👑 Representante</h3>
            <button onclick="verRol('representante')">Elegir este rol</button>
        </div>
        <div class="card">
            <h3>📜 Historiador</h3>
            <button onclick="verRol('historiador')">Elegir este rol</button>
        </div>
        <div class="card">
            <h3>🏚️ Sociólogo</h3>
            <button onclick="verRol('sociologo')">Elegir este rol</button>
        </div>
        <div class="card">
            <h3>🎨 Artista</h3>
            <button onclick="verRol('artista')">Elegir este rol</button>
        </div>
        <div class="card">
            <h3>✍️ Redactor</h3>
            <button onclick="verRol('redactor')">Elegir este rol</button>
        </div>
    </div>

    <div id="detalle">
        <h2 id="titulo-rol"></h2>
        <div class="instruccion">
            <p><strong>En la Cartelera:</strong> <span id="tarea-cartelera"></span></p>
            <p><strong>En la Exposición:</strong> <span id="tarea-exposicion"></span></p>
        </div>
    </div>

    <script>
        const info = {
            representante: {
                titulo: "👑 Representante (Líder)",
                cartelera: "Hacer el título principal gigante y organizar el orden de las secciones.",
                exposicion: "Presentar al grupo y explicar el tema general: ¿Qué fue la Peste Negra?"
            },
            historiador: {
                titulo: "📜 Historiador (Origen)",
                cartelera: "Dibujar el mapa de contagio y explicar cómo llegó la peste en barcos desde Asia.",
                exposicion: "Explicar los síntomas y el papel de las ratas y pulgas en el contagio."
            },
            sociologo: {
                titulo: "🏚️ Sociólogo (El Colapso)",
                cartelera: "Hacer la sección de 'Antes y Después' del feudalismo.",
                exposicion: "Explicar por qué los campesinos sobrevivientes cobraron más y dejaron a los señores feudales."
            },
            artista: {
                titulo: "🎨 Artista (Visual)",
                cartelera: "Dibujar al médico de la peste y decorar con bordes estilo antiguo.",
                exposicion: "Explicar los dibujos y por qué la gente de esa época estaba asustada."
            },
            redactor: {
                titulo: "✍️ Redactor (Conclusión)",
                cartelera: "Escribir los textos clave con letra clara y datos curiosos (como la cuarentena).",
                exposicion: "Dar el cierre y explicar cómo la peste ayudó a que el mundo cambiara hacia el Renacimiento."
            }
        };

        function verRol(rol) {
            document.getElementById('detalle').style.display = 'block';
            document.getElementById('titulo-rol').innerText = info[rol].titulo;
            document.getElementById('tarea-cartelera').innerText = info[rol].cartelera;
            document.getElementById('tarea-exposicion').innerText = info[rol].exposicion;
            window.scrollTo(0, document.body.scrollHeight);
        }
    </script>

</body>
</html>
